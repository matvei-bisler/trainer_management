# Скопируйте в .streamlit/secrets.toml (на Streamlit Cloud: Settings → Secrets)

# Адрес приложения — для ссылок на тесты
app_url = "https://your-app.streamlit.app"

# Без этого блока (или с пустым url) данные пишутся в локальные CSV (папка data/)
[apps_script]
url = "https://script.google.com/macros/s/…/exec"
token = "длинная-случайная-строка, та же, что в свойстве TOKEN скрипта"

# Банк вопросов для студентов: false — скрыть ответы (например, на время контрольных)
[student_bank]
show_answers = true

# У каждой страницы эксперта свой пароль
[passwords]
review = "пароль для разметки вопросов"
builder = "пароль для конструктора тестов"
results = "пароль для результатов"

# Необязательно: общий мастер-пароль, открывает все три страницы
# admin_password = "…"
